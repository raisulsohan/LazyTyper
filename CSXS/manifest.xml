<?xml version="1.0" encoding="UTF-8"?>
<!--
  LazyTyper - natural typing rigs for After Effects (AEFT).
  The manifest schema stays at 9.0, the oldest runtime the panel supports
  (CSXS 9). tools/package-zxp.mjs keeps both version numbers in step with
  package.json.
-->
<ExtensionManifest Version="9.0"
    ExtensionBundleId="com.sohan.LazyTyper"
    ExtensionBundleVersion="1.3.0"
    ExtensionBundleName="LazyTyper"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <ExtensionList>
        <Extension Id="com.sohan.LazyTyper.panel" Version="1.3.0" />
    </ExtensionList>

    <ExecutionEnvironment>
        <HostList>
            <Host Name="AEFT" Version="[18.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="9.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>

    <DispatchInfoList>
        <Extension Id="com.sohan.LazyTyper.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./host/host.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>LazyTyper</Menu>
                    <Geometry>
                        <Size>
                            <Height>720</Height>
                            <Width>340</Width>
                        </Size>
                        <MinSize>
                            <Height>320</Height>
                            <Width>260</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>2400</Height>
                            <Width>1200</Width>
                        </MaxSize>
                    </Geometry>
                    <Icons>
                        <Icon Type="Normal">./client/icons/icon-dark.png</Icon>
                        <Icon Type="RollOver">./client/icons/icon-dark.png</Icon>
                        <Icon Type="DarkNormal">./client/icons/icon-dark.png</Icon>
                        <Icon Type="DarkRollOver">./client/icons/icon-dark.png</Icon>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
